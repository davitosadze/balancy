####################################
# Directus – Local MySQL config
####################################

HOST=0.0.0.0
PORT=8055
PUBLIC_URL=http://192.168.0.107:8055

SECRET=loans_app_secret_change_in_production

# Database
DB_CLIENT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=loans
DB_USER=root
DB_PASSWORD=

# Admin account (created on first bootstrap)
ADMIN_EMAIL=admin@loans.app
ADMIN_PASSWORD=Admin123!

# Cache – disabled (no Redis locally)
CACHE_ENABLED=false

# CORS – allow Expo dev server
CORS_ENABLED=true
CORS_ORIGIN=true

# Storage
STORAGE_LOCATIONS=local
STORAGE_LOCAL_ROOT=./uploads

# Logging
LOG_LEVEL=info

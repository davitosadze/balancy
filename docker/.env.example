# ─── Directus Core ─────────────────────────────────────────────────────────────
DIRECTUS_SECRET=change_me_in_production_very_long_secret_at_least_32_chars
ADMIN_EMAIL=admin@loans.app
ADMIN_PASSWORD=Admin123!
DIRECTUS_PUBLIC_URL=http://localhost:8055

# ─── Database ──────────────────────────────────────────────────────────────────
DB_DATABASE=loans
DB_USER=directus
DB_PASSWORD=directus_password

# ─── OAuth ─────────────────────────────────────────────────────────────────────
# Get from Google Cloud Console (OAuth 2.0 Client IDs)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Get from Apple Developer (Sign in with Apple)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# The UUID of the default "Authenticated User" role in Directus
DEFAULT_ROLE_ID=

# ─── Email (optional) ──────────────────────────────────────────────────────────
EMAIL_FROM=noreply@loans.app
EMAIL_TRANSPORT=smtp
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
